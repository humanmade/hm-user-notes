{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"landingPage": "/",
	"login": true,
	"preferredVersions": {
		"php": "8.4",
		"wp": "6.9"
	},
	"features": {
		"intl": true,
		"networking": true
	},
	"siteOptions": {
		"blogname": "HM User Notes"
	},
	"extraLibraries": [
		"wp-cli"
	],
	"steps": [
		{
			"step": "defineWpConfigConsts",
			"consts": {
				"WP_DEBUG": true,
				"WP_DEBUG_LOG": true,
				"SCRIPT_DEBUG": true
			}
		},
        {
            "step": "installPlugin",
            "pluginData": {
                "resource": "wordpress.org/plugins",
                "slug": "user-switching"
            },
            "options": {
                "activate": true
            }
        },
		{
            "step": "wp-cli",
            "command": "wp user create subscriber subscriber@example.com --role=subscriber"
        }
	]
}
